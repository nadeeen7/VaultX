# SIEM Backend Environment Variables
# Copy this file to .env and update values for your environment.
# NEVER commit .env files with real secrets to Git.

# ── CORS ──
# Comma-separated list of allowed frontend/backend origins
# Example: https://siem.yourdomain.com,https://bank.yourdomain.com
CORS_ORIGINS=https://siem.yourdomain.com,https://bank.yourdomain.com

# ── Database ──
# Production: use managed PostgreSQL connection string with SSL
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE_NAME?sslmode=require
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/vaultx_siem

# ── Flask / Security ──
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=generate-a-random-64-char-hex-string
JWT_SECRET_KEY=generate-a-different-random-64-char-hex-string

# ── API Key for Bank→SIEM event ingestion ──
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SIEM_API_KEY=generate-a-strong-random-api-key

# ── SecureBank Collector ──
# Server-to-server URL for polling Bank security events
SECUREBANK_API_URL=https://bank-api.yourdomain.com/api/security-events
SECUREBANK_API_KEY=generate-a-strong-random-api-key
SECUREBANK_POLL_INTERVAL=10

# ── Server ──
PORT=5001

# ── Advanced Correlation Detection Thresholds ──
BRUTE_FORCE_THRESHOLD=5
BRUTE_FORCE_WINDOW_MINUTES=5
PASSWORD_SPRAY_USER_THRESHOLD=5
PASSWORD_SPRAY_WINDOW_MINUTES=10
DISTRIBUTED_AUTH_THRESHOLD=5
DISTRIBUTED_AUTH_WINDOW_MINUTES=60
DISTRIBUTED_AUTH_UNIQUE_IP_THRESHOLD=3
DISTRIBUTED_AUTH_UNIQUE_USER_THRESHOLD=3
MULTI_SOURCE_ACCOUNT_THRESHOLD=3
MULTI_SOURCE_ACCOUNT_WINDOW_MINUTES=15
ALERT_DEDUP_WINDOW_MINUTES=15

# ── Notifications (optional) ──
DISCORD_WEBHOOK_URL=
SLACK_WEBHOOK_URL=
EMAIL_NOTIFICATIONS_ENABLED=false
