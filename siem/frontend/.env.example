# SIEM Frontend Environment Variables
# Copy this file to .env and update values for your environment.
# NEVER commit .env files with real secrets to Git.
#
# NOTE: VITE_* variables are embedded in the frontend bundle at build time.
# They are PUBLIC and visible to end users. NEVER put secrets, passwords,
# or API keys in VITE_* variables.

# Backend API base URL (no trailing slash)
# Local dev: leave unset to use Vite dev server proxy
# Production: set to your deployed backend URL
# Example: VITE_API_URL=https://siem-api.yourdomain.com
VITE_API_URL=

# Socket.IO URL (backend WebSocket endpoint)
# Local dev: leave unset to use Vite dev server proxy
# Production: set to your deployed backend URL (must support WebSocket/WSS)
# Example: VITE_SOCKET_URL=wss://siem-api.yourdomain.com
VITE_SOCKET_URL=

# Bank API URL (displayed in sidebar as reference)
# Production: set to your deployed bank backend URL
# Example: VITE_BANK_API_URL=https://bank-api.yourdomain.com
VITE_BANK_API_URL=
