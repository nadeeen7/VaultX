# Bank Frontend Environment Variables
# Copy this file to .env and update values for your environment.
# NEVER commit .env files with real secrets to Git.
#
# NOTE: VITE_* variables are embedded in the frontend bundle at BUILD time.
# They are PUBLIC and visible to end users. NEVER put secrets, passwords,
# or API keys in VITE_* variables.

# ── Required in Production ──
# Backend API base URL (no trailing slash)
# When unset, the frontend uses relative /api paths (works with Vite dev proxy only).
# In production, this MUST point to your deployed backend:
VITE_API_URL=https://vaultx-bank-api.onrender.com

# ── Optional — Google Sign-In ──
# Your Google OAuth 2.0 Client ID (Web application type)
# Get this from Google Cloud Console → APIs & Services → Credentials
# This is PUBLIC and safe to include in frontend bundles.
# Without this, the "Continue with Google" button will not appear.
# VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# ── Local Development ──
# For local dev, either:
#   1. Leave VITE_API_URL unset and rely on the Vite dev server proxy, or
#   2. Set: VITE_API_URL=http://localhost:5000
