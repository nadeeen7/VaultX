[TEMPLATE]
# Bank Backend Environment Variables
# Copy this file to .env and update values for your environment.
# NEVER commit .env files with real secrets to Git.

# ──────────────────────────────────────────────────
# REQUIRED — Application will not start properly without these
# ──────────────────────────────────────────────────

# Database connection string (PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE_NAME?sslmode=require
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/vaultx_bank

# Flask secret key for sessions and CSRF protection
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=generate-a-random-64-char-hex-string

# JWT token signing key
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=generate-a-different-random-64-char-hex-string

# ──────────────────────────────────────────────────
# OPTIONAL — Bank works without these, add when ready
# ──────────────────────────────────────────────────

# Set to 'production' for Render deployment (default: development)
# FLASK_ENV=production

# CORS: comma-separated list of allowed frontend origins
# Leave empty to block all cross-origin requests (most secure)
# Add your frontend URL(s) when the frontend is deployed
# Example: CORS_ORIGINS=https://bank.yourdomain.com
# CORS_ORIGINS=

# SIEM backend URL — security events will be logged locally but not pushed to SIEM
# Add when the SentinelSIEM backend is deployed
# Example: SIEM_API_URL=https://siem-api.yourdomain.com
# SIEM_API_URL=

# SIEM API key — shared secret for Bank→SIEM authentication
# Must match the SIEM backend's SIEM_API_KEY
# Example: SIEM_API_KEY=your-generated-api-key
# SIEM_API_KEY=

# ──────────────────────────────────────────────────
# OPTIONAL — Google Sign-In (Feature 1)
# ──────────────────────────────────────────────────
# Get these from Google Cloud Console → APIs & Services → Credentials
# Create an OAuth 2.0 Client ID (Web application type)
# Add your frontend domain as an authorized JavaScript origin
# Add your backend URL as an authorized redirect URI (not strictly needed for token-based flow)
#
# GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your-google-client-secret

# ──────────────────────────────────────────────────
# OPTIONAL — Email / SMTP (Feature 2: Forgot Password OTP)
# ──────────────────────────────────────────────────
# Required for sending OTP emails (forgot password feature)
#
# GMAIL SETUP (2 steps — the app password alone is NOT enough):
#   1. Enable 2-Step Verification on the Google account, then create an
#      App Password: https://myaccount.google.com/apppasswords
#      (use the 16-character app password as MAIL_PASSWORD, with no spaces)
#   2. Use one of these port/encryption combinations:
#        MAIL_PORT=587  → the app upgrades the connection with STARTTLS (recommended)
#        MAIL_PORT=465  → implicit SSL/TLS (also supported)
#
# For production at scale: use SendGrid, Mailgun, AWS SES, or similar
#
# MAIL_SERVER=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=your-email@gmail.com
# MAIL_PASSWORD=your-16-char-app-password
# MAIL_DEFAULT_SENDER=your-email@gmail.com

# Frontend URL — used for email links
# FRONTEND_URL=https://vault-bank.yourdomain.com

# ──────────────────────────────────────────────────
# OPTIONAL — Security tuning (defaults shown)
# ──────────────────────────────────────────────────

# MAX_LOGIN_ATTEMPTS=5
# LOCKOUT_DURATION_MINUTES=15
# RATE_LIMIT_PER_MINUTE=60

# ──────────────────────────────────────────────────
# OPTIONAL — Database connection pool tuning (defaults shown)
# ──────────────────────────────────────────────────
# Production-safe defaults for Render PostgreSQL are already active
# (pool_pre_ping=True, pool_recycle=280s, pool_timeout=30s, pool_size=3,
# max_overflow=5, connect_timeout=10s). Only override if you know why.
# In production (FLASK_ENV=production), sslmode=require is appended to
# DATABASE_URL automatically unless the URL already contains an sslmode.

# DB_POOL_RECYCLE=280
# DB_POOL_TIMEOUT=30
# DB_POOL_SIZE=3
# DB_MAX_OVERFLOW=5
# DB_CONNECT_TIMEOUT=10
